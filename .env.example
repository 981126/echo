# echo 配置模板：复制为 .env 并填写（.env 已被 gitignore，绝不上传）
# 访问令牌（Web 入口校验，必填）
ECHO_ACCESS_TOKEN=change-me

# DeepSeek
ECHO_DEEPSEEK_API_KEY=sk-xxx
ECHO_DEEPSEEK_BASE_URL=https://api.deepseek.com
ECHO_DEEPSEEK_MODEL=deepseek-flash

# ASR 服务商（R-108/R-200）：mock（开发/测试）| aliyun | siliconflow | tencent（界面「AI 设置」也可切换并保存即生效）
ECHO_ASR_MODE=mock

# 阿里云 ASR（asr_mode=aliyun 时使用）
ECHO_ALIYUN_ASR_ACCESS_KEY_ID=
ECHO_ALIYUN_ASR_ACCESS_KEY_SECRET=
ECHO_ALIYUN_ASR_APP_KEY=

# 硅基流动 ASR（R-108，asr_mode=siliconflow 时使用；模型可用平台实际值覆盖）
ECHO_SILICONFLOW_API_KEY=sk-xxx
ECHO_SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
ECHO_SILICONFLOW_ASR_MODEL=Qwen/Qwen3-ASR-1.7B  # 硅基流动免费 ASR（官方定价页标注免费）

# 腾讯云 ASR（R-200，asr_mode=tencent 时使用）：录音文件识别
# SecretId/SecretKey 在腾讯云「访问管理 → API 密钥管理」获取；引擎在界面「AI 设置」切换
ECHO_TENCENT_ASR_SECRET_ID=
ECHO_TENCENT_ASR_SECRET_KEY=
ECHO_TENCENT_ASR_REGION=ap-guangzhou
ECHO_TENCENT_ASR_ENGINE_MODEL=16k_zh_en_2.0  # 大模型2.0（可选 16k_zh_en / 16k_zh）
ECHO_TENCENT_ASR_MAX_AUDIO_MB=5  # 腾讯本地音频直传上限

# QQ 邮箱 SMTP
ECHO_SMTP_HOST=smtp.qq.com
ECHO_SMTP_PORT=465
ECHO_SMTP_USER=yourname@qq.com
ECHO_SMTP_AUTH_CODE=授权码（非登录密码）
ECHO_MAIL_TO=接收邮箱

# 每日流水线
ECHO_DAILY_PUSH_TIME=07:00
ECHO_TZ=Asia/Shanghai

# 路径
ECHO_DATA_DIR=./data
ECHO_DB_PATH=./data/echo.db

# 热点与流水线
ECHO_HOT_SOURCE_MODE=mock          # mock | real（real 需 NAS 有外网）
ECHO_PIPELINE_TOPICS_COUNT=3
ECHO_WEB_BASE_URL=http://localhost:8000   # 邮件内"去工作台"链接前缀，部署后改成 NAS 地址

# 生成策略（R-023）：deepseek|kimi|random|alternate
# Kimi / Moonshot（R-023）
ECHO_KIMI_API_KEY=
ECHO_KIMI_BASE_URL=https://api.moonshot.cn/v1
ECHO_KIMI_MODEL=kimi-k2.6
ECHO_GENERATION_MODEL=deepseek
ECHO_DEBATE_ROUNDS=5
# 单次 LLM 调用墙钟上限（秒），超过按超时处理并降级到模型2
ECHO_LLM_TIMEOUT_SECONDS=600
# 灵感池进池限量（R-140）：每条作品最多进池 N 条、每个博主每天最多进池 N 条（0=不限）
# AI 对话 agent（R-147）：最多几轮工具循环 / 单次提问最多几次工具调用 / 墙钟上限（秒）
ECHO_AGENT_MAX_ROUNDS=8
ECHO_AGENT_MAX_TOOL_CALLS=16
ECHO_AGENT_TIMEOUT_SECONDS=120

ECHO_POOL_IDEAS_PER_POST=8
ECHO_POOL_IDEAS_PER_DAY=40

# 平台数据同步（M13，R-027/R-029）：TikHub 第三方聚合
# ECHO_TIKHUB_MODE=real 时使用真实接口（会消耗你的 TikHub 额度），需配好下面 key
ECHO_TIKHUB_API_KEY=
ECHO_TIKHUB_BASE_URL=https://api.tikhub.io/api/v1
ECHO_TIKHUB_MODE=mock          # mock | real
ECHO_TIKHUB_DAILY_BUDGET=2000
ECHO_PLATFORM_SYNC_TIMES=06:00,17:00
# R-163 同步并发与全局限速
# 全局 TikHub 请求上限（所有接口合计，req/s）；突发容量（令牌桶）
ECHO_TIKHUB_RATE_LIMIT=10
ECHO_TIKHUB_RATE_BURST=10
# 并行消费者数：博主级（多个博主同时同步）/ 素材级（下载+转写较重，独立小池）
ECHO_SYNC_CONCURRENCY=4
ECHO_SYNC_MEDIA_CONCURRENCY=2

# 联网搜索（R-227）：火山引擎豆包搜索（融合信息搜索），为生成/洗稿补充真实事实/数据。
# 不配 key 时联网能力静默关闭（不影响生成）。控制台：https://console.volcengine.com/search-infinity/api-key
ECHO_WEB_SEARCH_API_KEY=
ECHO_WEB_SEARCH_BASE_URL=https://open.feedcoopapi.com/search_api/web_search
ECHO_WEB_SEARCH_COUNT=5
ECHO_WEB_SEARCH_CACHE_SECONDS=3600
ECHO_WEB_SEARCH_TIMEOUT_SECONDS=15

# 联网参考（R-233）：DeepSeek Search/Fetch 与豆包并行（复用上面的 ECHO_DEEPSEEK_API_KEY / BASE_URL）。
# 文档：https://api-docs.deepseek.com/zh-cn/guides/search ；计费 5 元/千次，账号级各 5 QPS。
ECHO_ONLINE_SEARCH_ENABLED=true
ECHO_DEEPSEEK_SEARCH_ENABLED=true
ECHO_DEEPSEEK_SEARCH_COUNT=5
ECHO_ONLINE_SEARCH_TIMEOUT_SECONDS=20
ECHO_ONLINE_FETCH_ENABLED=true
ECHO_ONLINE_FETCH_MAX=4
ECHO_ONLINE_FETCH_TIMEOUT_SECONDS=15
ECHO_ONLINE_FETCH_CHARS=2000
ECHO_ONLINE_MIN_CONTENT_CHARS=800
ECHO_ONLINE_BUDGET_SECONDS=25
# 生成方按当前主博主人设选 2–3 篇（关掉则按相关度自动取前几篇）
ECHO_ONLINE_REF_PICK=true
ECHO_ONLINE_REF_PICK_MIN=2
ECHO_ONLINE_REF_PICK_MAX=3
ECHO_ONLINE_PICK_TIMEOUT_SECONDS=45
# 营销/内容农场站点（逗号分隔，URL 子串匹配）
ECHO_ONLINE_SITE_BLACKLIST=k.sina.com.cn,baijiahao.baidu.com,sohu.com/a/,163.com/dy/,qq.com/omn/,book118.com,docin.com,renrendoc.com,taobao.com,tmall.com,jd.com,pinduoduo.com,1688.com
